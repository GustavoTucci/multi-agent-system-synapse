# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv





# --- Ambientes Virtuais (Virtual Environments) ---
.venv/
venv/
env/
ENV/
pyvenv.cfg
.python-version
pip-log.txt
pip-delete-this-directory.txt

# --- Configurações de Credenciais e Variáveis de Ambiente ---
# NUNCA commit arquivos contendo chaves de API, senhas ou tokens
.env
.env.local
.env.*.local
secrets.json
*.pem
*.key
*.pub

# --- Arquivos de Dados Grandes ---
# O Home Credit Dataset possui arquivos CSV/Parquet pesados que não devem ir ao Git
*.csv
*.xlsx
*.jsonl
*.parquet
*.zip
*.tar.gz
data/
datasets/
inputs/
outputs/

# --- Cache do Python e Compilação ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.log

# --- Configurações de IDEs e Editores ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~
.project
.pydevproject
.settings/

# --- Ferramentas Locais de Agente ---
# Ignorar dados e sessões locais de execução dos agentes
.antigravitycli/
sessions/
logs/
*.db
*.sqlite

# --- Arquivos do Sistema Operacional ---
.DS_Store
Thumbs.db
desktop.ini
